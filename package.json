{
  "name": "bb-plugin-lanes",
  "version": "0.1.1",
  "type": "module",
  "description": "A bb plugin showing every model lane's headroom in one place. bb tracks Claude Code and Codex natively; this adds OpenCode Zen Go and OpenRouter, normalised into the same shape.",
  "keywords": [
    "bb",
    "bb-plugin",
    "getbb",
    "agent-ide",
    "ai-agents",
    "usage-limits",
    "rate-limits",
    "openrouter",
    "opencode",
    "claude-code",
    "codex"
  ],
  "author": "Shane Logsdon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slogsdon/bb-plugin-lanes.git"
  },
  "bugs": {
    "url": "https://github.com/slogsdon/bb-plugin-lanes/issues"
  },
  "homepage": "https://github.com/slogsdon/bb-plugin-lanes#readme",
  "license": "MIT",
  "scripts": {
    "types": "bb plugin types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bb plugin build ."
  },
  "engines": {
    "bb": ">=0.37",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Lanes",
    "description": "Model lane headroom: Claude, Codex, OpenCode Go, and OpenRouter in one place.",
    "branding": {
      "icon": "Gauge"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "^0.38.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "files": [
    "dist"
  ]
}
